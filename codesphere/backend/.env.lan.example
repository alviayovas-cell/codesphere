# Env template for the "contest day, everything on one LAN PC" deployment.
# Copy to backend/.env on the venue machine, fill in JWT_SECRET_KEY, then
# run `docker compose up --build` from the repo root. See
# DEPLOY_LAN_WINDOWS.md for the full walkthrough.
#
# MONGODB_URI and REDIS_URL are intentionally NOT set here - docker-compose.yml
# overrides both to point at the `mongo`/`redis` containers it starts, so
# whatever is in this file for those two is ignored under `docker compose up`.

APP_NAME=CodeSphere API
ENVIRONMENT=production
MONGODB_DB_NAME=codesphere

# Real secret required because ENVIRONMENT=production above - generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=720

# CORS_ORIGINS mostly doesn't matter for this deployment - the frontend calls
# a same-origin relative /api path (proxied by nginx), so the browser never
# makes a cross-origin request to begin with. Left here only in case
# something ever hits the backend's own :8000 port directly from a browser.
CORS_ORIGINS=["http://localhost:5173"]

# Judge0, self-hosted from ../judge0-selfhosted/ on the SAME machine.
# host.docker.internal lets the backend container reach a port published on
# the Windows host itself (Docker Desktop resolves this automatically) -
# that's where judge0-selfhosted's docker-compose.yml publishes 2358.
JUDGE0_API_URL=http://host.docker.internal:2358
JUDGE0_API_KEY=
JUDGE0_API_HOST=
JUDGE0_C_LANGUAGE_ID=50
JUDGE0_REQUEST_TIMEOUT_SECONDS=30

RUN_RATE_LIMIT_PER_MINUTE=5
SUBMIT_RATE_LIMIT_PER_MINUTE=3

RUN_JOB_TIMEOUT_SECONDS=140
SUBMIT_JOB_TIMEOUT_SECONDS=140
JOB_RESULT_TTL_SECONDS=3600
