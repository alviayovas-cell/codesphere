APP_NAME=CodeSphere API
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173"]

# Local MongoDB, or a MongoDB Atlas connection string for production
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=codesphere

# Generate a real secret for anything beyond local dev, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app refuses to start with this placeholder value if ENVIRONMENT != development (see app/core/config.py).
JWT_SECRET_KEY=dev-only-insecure-secret-change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=720

# Judge0 code execution. Defaults to the free public Judge0 CE demo instance,
# which works out of the box for development but is rate-limited and not
# suitable for a real coding event - point this at a self-hosted or
# RapidAPI-hosted Judge0 instance for production, and set the API key/host
# below if using RapidAPI.
JUDGE0_API_URL=https://ce.judge0.com
JUDGE0_API_KEY=
JUDGE0_API_HOST=
JUDGE0_C_LANGUAGE_ID=50
JUDGE0_REQUEST_TIMEOUT_SECONDS=30

# Run Code / Submit Code rate limits per student (spec section 11)
RUN_RATE_LIMIT_PER_MINUTE=5
SUBMIT_RATE_LIMIT_PER_MINUTE=3

# Redis + RQ job queue (spec section 12). Needs a real Redis instance and at
# least one `python -m app.workers.run_worker` process running to actually
# process jobs - the API will accept and queue Run/Submit requests either
# way, but they'll sit at "queued" forever without a worker running.
REDIS_URL=redis://localhost:6379/0
RUN_JOB_TIMEOUT_SECONDS=45
SUBMIT_JOB_TIMEOUT_SECONDS=120
JOB_RESULT_TTL_SECONDS=3600
